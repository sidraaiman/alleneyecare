# ---------------------------------------------------------------------------
# AllenEyeCare environment
# Copy this file to `.env` and fill in your Supabase project values.
# Leaving the URL as the placeholder below runs the app in DEMO mode
# (auth bypassed, local products, mocked orders).
# ---------------------------------------------------------------------------

# Supabase — safe to expose. The anon key is public by design (RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# AI assistant
# By default the assistant runs fully on-device (services/assistant.ts) — free,
# instant, and never rate-limited. No key or backend needed.
#
# OPTIONAL: to use a cloud LLM (Google Gemini) instead, set the flag below and
# deploy the Edge Function with the key server-side (never behind EXPO_PUBLIC_).
# If the cloud model errors or hits its rate limit, it auto-falls back to local.
#   Get a free key: https://aistudio.google.com/app/apikey
#   supabase functions deploy ai-chat
#   supabase secrets set GEMINI_API_KEY=AIza...
# EXPO_PUBLIC_USE_CLOUD_AI=true
# ---------------------------------------------------------------------------
